# The backend reads backend/.env (preferred) or this repository-root .env.
# See backend/.env.example for every variable with explanations.
# Frontend variables live in frontend/.env (see frontend/.env.example).

NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id-or-neo4j>
NEO4J_PASSWORD=<aura-password>
NEO4J_DATABASE=<instance-id-or-neo4j>

JWT_SECRET=<at-least-32-random-characters>

LLM_PROVIDER=gemini
LLM_API_KEY=
