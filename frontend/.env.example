# OmniGraph frontend configuration (copy to frontend/.env). Never put secrets in VITE_* variables:
# they are bundled into public JavaScript.

# Production: public origin of the deployed API (e.g. https://omnigraph-api.onrender.com).
# Leave unset when the API is served from the same origin as the frontend.
# The API's CORS_ORIGINS must include the frontend origin.
# VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies API calls (default http://localhost:8000).
# VITE_DEV_API_TARGET=http://localhost:8000
