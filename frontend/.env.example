# OmniGraph frontend API base URL (optional)
#
# Development (recommended): leave unset or empty — requests use same-origin paths
# and Vite proxies /auth and /health to http://localhost:8000 (see vite.config.ts).
#
# Production / preview without proxy:
# VITE_API_BASE_URL=http://localhost:8000
#
# VITE_API_BASE_URL=
