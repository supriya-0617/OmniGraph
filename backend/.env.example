# OmniGraph backend configuration.
# Copy to backend/.env (gitignored) and fill in. Never commit real secrets.

# development | production   (production refuses to start with unsafe defaults)
ENVIRONMENT=development

# ---------------------------------------------------------------- Neo4j Aura
# Leave NEO4J_URI empty to run on the in-memory development graph.
# Paste the values from the Aura credentials file (NEO4J_USER is also accepted).
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id-or-neo4j>
NEO4J_PASSWORD=<aura-password>
NEO4J_DATABASE=<instance-id-or-neo4j>

# ---------------------------------------------------------------- Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<at-least-32-random-characters>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Demo login 1234/1234 — only works in memory mode, must be false in production.
DEV_DEFAULT_ACCOUNT_ENABLED=false

# ---------------------------------------------------------------- HTTP
# Comma-separated frontend origins allowed by CORS (e.g. your Vercel URL).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- GraphRAG LLM
# Provider: gemini | vertex | openai | anthropic   (see app/ai/llm_client.py)
#   gemini    — Google AI Studio API key (https://aistudio.google.com/apikey)
#   vertex    — Vertex AI; bills Google Cloud credits (e.g. the $300 trial).
#               Use a Vertex AI API key in LLM_API_KEY, or a service account via
#               GOOGLE_APPLICATION_CREDENTIALS + VERTEX_PROJECT_ID (pip install google-auth requests).
#   openai    — any OpenAI-compatible endpoint; set LLM_BASE_URL for OpenRouter/Groq/etc.
#   anthropic — Anthropic API key
LLM_PROVIDER=gemini
LLM_API_KEY=
# Blank = provider default (gemini-3.8-flash). For deepest reasoning: gemini-4-argon (raise the timeout to ~90).
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=8192
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
# Per-analyst AI queries per minute (protects your API quota).
AI_RATE_LIMIT_PER_MINUTE=8

# ---------------------------------------------------------------- Live stream simulation (optional)
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=20
